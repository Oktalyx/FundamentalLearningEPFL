    "# TODO: Bootstrap the fitted parameters and report their 95% intervals; optionally repeat for MAP.\n",
    "\n",
    "N_boot = 1000\n",
    "\n",
    "def bootstrap_fit(objective, x, x0_init, y0_init, bounds, N_boot):\n",
    "    x0_boot = np.zeros(N_boot)\n",
    "    y0_boot = np.zeros(N_boot)\n",
    "    for b in range(N_boot):\n",
    "        x_resampled = np.random.choice(x, size=len(x), replace=True)\n",
    "        x0_b, y0_b = checked_minimize(\n",
    "            lambda params: -objective(params[0], params[1], x_resampled),\n",
    "            [x0_init, y0_init],\n",
    "            bounds=bounds,\n",
    "        )\n",
    "        x0_boot[b] = x0_b\n",
    "        y0_boot[b] = y0_b\n",
    "    return x0_boot, y0_boot\n",
