   "source": [
    "Define helpers that simulate datasets and return repeated ML and sample-median position estimates."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 41,
   "metadata": {
    "tags": [
     "exercise"
    ]
   },
   "outputs": [],
   "source": [
    "# TODO: Define helpers for repeated ML and sample-median position estimates.\n",
    "\n",
    "def position_estimates(x0, y0, N, N_rep):\n",
    "    ml_est = np.zeros(N_rep)\n",
    "    median_est = np.zeros(N_rep)\n",
    "    for ir in range(N_rep):\n",
    "        x = cauchy.rvs(loc=x0, scale=y0, size=N)\n",
    "        x0_guess = np.median(x)\n",
    "        ml_est[ir] = checked_minimize(\n",
    "            lambda params: -loglh(params[0], y0, x),\n",
    "            [x0_guess],\n",
    "        )[0]\n",
    "        median_est[ir] = x0_guess\n",
    "    return ml_est, median_est"
   ]
